{
  "name": "epub-viewer",
  "version": "2.0.2",
  "private": true,
  "license": "MIT",
  "description": "Browser EPUB viewer library for text in vertical or horizontal writing and fixed-layout books (manga), plus a standalone reader app",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc && tsc --emitDeclarationOnly --removeComments false",
    "dev": "node scripts/serve.js --build",
    "samples": "node scripts/make-samples.js",
    "site": "node scripts/make-site.js",
    "test": "tsc && npm run samples && npm run site && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "7.0.2"
  }
}
